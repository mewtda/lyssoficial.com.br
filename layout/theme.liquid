<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#ffffff">
    <link rel="canonical" href="{{ canonical_url }}">
    {{ 'Geist-Variable.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'Newsreader-Variable.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {% style %}
      :root {
        --color-text: {{ settings.color_text }};
        --color-text-rgb: {{ settings.color_text.red }}, {{ settings.color_text.green }}, {{ settings.color_text.blue }};
        --color-bg: {{ settings.color_background }};
        --color-accent-bg: {{ settings.color_accent_background }};
        --color-accent-text: {{ settings.color_accent_text }};
        --color-button: {{ settings.color_button }};
        --color-button-text: {{ settings.color_button_text }};
        --color-sale: {{ settings.color_sale }};
        --color-placeholder: #eae7e4;
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          search: {{ routes.predictive_search_url | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
    {% render 'search-dialog' %}
    
{% if request.page_type == 'index' %}
<div id="lyss-intro" style="display:none" aria-label="Vídeo de abertura LYSS">
  <video
    id="lyss-intro-video"
    autoplay
    muted
    playsinline
    preload="auto"
  >
    <source src="https://cdn.shopify.com/videos/c/o/v/20195acba9b74a45af4930a8e77c145f.mov" type="video/mp4">
  </video>

  <button id="lyss-intro-skip" type="button">
    Pular vídeo ✕
  </button>

<button id="lyss-intro-sound" type="button">
  🔊 Ativar som
</button>
</div>

<style>
  @media screen and (min-width: 750px) {
  #lyss-intro {
    display: none !important;
  }
}

#lyss-intro {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    height: 100dvh;
    background: #000;
    z-index: 2147483647;
    overflow: hidden;
  }

  #lyss-intro-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #lyss-intro-skip {
    position: absolute;
    right: 25px;
    bottom: 35px;
    padding: 12px 22px;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.6);
    border-radius: 30px;
    font-size: 13px;
    letter-spacing: 1px;
    cursor: pointer;
    z-index: 2;
  }

  @media (max-width: 749px) {
    #lyss-intro-skip {
      right: 18px;
      bottom: 30px;
    }
  }
  #lyss-intro-sound {
  position: absolute;
  left: 18px;
  bottom: 30px;
  padding: 12px 18px;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 30px;
  font-size: 13px;
  cursor: pointer;
  z-index: 2;
}
</style>

<script>
(function () {
  const intro = document.getElementById('lyss-intro');
  const video = document.getElementById('lyss-intro-video');
  const skip = document.getElementById('lyss-intro-skip');
const sound = document.getElementById('lyss-intro-sound');

if (sound) {
  sound.addEventListener('click', function () {
    video.muted = !video.muted;

    sound.textContent = video.muted
      ? '🔊 Ativar som'
      : '🔇 Desativar som';
  });
}
  if (!intro || !video || !skip) return;
  if (window.innerWidth >= 750) return;

  const key = 'lyss_intro_seen';

  try {
    if (sessionStorage.getItem(key)) return;
  } catch (e) {}

  let finished = false;
  let fallback;

  function closeIntro() {
    if (finished) return;
    finished = true;

    clearTimeout(fallback);
    video.pause();
    intro.style.display = 'none';

    try {
      sessionStorage.setItem(key, '1');
    } catch (e) {}
  }

  skip.addEventListener('click', closeIntro);
  video.addEventListener('ended', closeIntro);
  video.addEventListener('error', closeIntro);

  intro.style.display = 'block';

  const playPromise = video.play();

  if (playPromise && typeof playPromise.catch === 'function') {
    playPromise.catch(closeIntro);
  }

  fallback = setTimeout(closeIntro, 120000);
})();
</script>
{% endif %}

  </body>
</html>
