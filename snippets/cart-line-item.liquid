{% doc %}
  Renders a cart line item with quantity controls.

  @param {object} item - The cart line item
  @param {number} index - 1-based line index

  @example
  {% render 'cart-line-item', item: item, index: forloop.index %}
{% enddoc %}

<div class="cart-item" data-cart-line="{{ index }}">
  <a href="{{ item.url }}" class="cart-item__media">
    {%- if item.image -%}
      {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.product.title, widths: '150, 300' }}
    {%- endif -%}
  </a>
  <div class="cart-item__details">
    <div class="cart-item__top">
      <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
      <div class="price">
        {%- if item.original_line_price > item.final_line_price -%}
          <s class="price__compare">{{ item.original_line_price | money }}</s>
        {%- endif -%}
        <span>{{ item.final_line_price | money }}</span>
      </div>
    </div>
    {%- unless item.product.has_only_default_variant -%}
      <p class="cart-item__options">
        {%- for option in item.options_with_values -%}
          {{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}
        {%- endfor -%}
      </p>
    {%- endunless -%}
    {%- for property in item.properties -%}
      {%- assign first_char = property.first | slice: 0 -%}
      {%- if property.last != blank and first_char != '_' -%}
        <p class="cart-item__options">{{ property.first }}: {{ property.last }}</p>
      {%- endif -%}
    {%- endfor -%}
    {%- for discount in item.line_level_discount_allocations -%}
      <p class="cart-item__options">{{ discount.discount_application.title }} (-{{ discount.amount | money }})</p>
    {%- endfor -%}
    <div class="cart-item__actions">
      <div class="quantity">
        <button type="button" aria-label="{{ 'cart.decrease' | t }}" data-qty-change="{{ item.quantity | minus: 1 }}" data-line="{{ index }}">
          {% render 'icon', icon: 'minus', class: 'icon--small' %}
        </button>
        <input type="number" min="0" value="{{ item.quantity }}" aria-label="{{ 'cart.quantity' | t }}" data-qty-input data-line="{{ index }}">
        <button type="button" aria-label="{{ 'cart.increase' | t }}" data-qty-change="{{ item.quantity | plus: 1 }}" data-line="{{ index }}">
          {% render 'icon', icon: 'plus', class: 'icon--small' %}
        </button>
      </div>
      <button type="button" class="cart-item__remove" data-qty-change="0" data-line="{{ index }}">{{ 'cart.remove' | t }}</button>
    </div>
  </div>
</div>
