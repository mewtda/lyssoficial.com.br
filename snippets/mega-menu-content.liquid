{% doc %}
  Renders the links and promo cards of a mega menu panel.

  @param {object} link - The top-level menu link
  @param {object} [promo] - Matching mega menu block, if any

  @example
  {% render 'mega-menu-content', link: link, promo: promo %}
{% enddoc %}

{%- assign has_grandchildren = false -%}
{%- for child in link.links -%}
  {%- if child.links.size > 0 -%}
    {%- assign has_grandchildren = true -%}
  {%- endif -%}
{%- endfor -%}

{%- if has_grandchildren -%}
  {%- for child in link.links -%}
    <div class="mega-menu__links">
      <a href="{{ child.url }}" class="mega-menu__title desktop-only">{{ child.title }}</a>
      <ul class="mega-menu__list">
        {%- for grandchild in child.links -%}
          <li><a href="{{ grandchild.url }}" class="link-animation">{{ grandchild.title }}</a></li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endfor -%}
{%- else -%}
  <div class="mega-menu__links">
    <span class="mega-menu__title desktop-only">{{ link.title }}</span>
    <ul class="mega-menu__list">
      {%- for child in link.links -%}
        <li><a href="{{ child.url }}" class="link-animation"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{%- if promo -%}
  {%- assign promo_type = promo.settings.content_type | default: 'images' -%}
  {%- case promo_type -%}
    {%- when 'products' -%}
      {%- if promo.settings.products != blank -%}
        <div class="mega-menu__featured mega-menu__featured--{{ promo.settings.featured_size | default: 'fill' }}">
          {%- if promo.settings.featured_heading != blank -%}
            <p class="mega-menu__title">{{ promo.settings.featured_heading }}</p>
          {%- endif -%}
          <ul class="mega-menu__featured-list" role="list">
            {%- for product in promo.settings.products limit: 5 -%}
              <li>
                <a href="{{ product.url }}" class="mega-product">
                  <span class="mega-product__media">
                    {%- if product.featured_media -%}
                      {{ product.featured_media.preview_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title, sizes: '(min-width: 768px) 25vw, 60vw', widths: '240, 360, 500, 700', class: 'mega-product__image' }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                    {%- if product.media.size > 1 -%}
                      {{ product.media[1].preview_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: '', sizes: '(min-width: 768px) 25vw, 60vw', widths: '240, 360, 500, 700', class: 'mega-product__image mega-product__image--hover' }}
                    {%- endif -%}
                    {%- if product.available == false -%}
                      <span class="mega-product__badge">{{ 'products.product.sold_out' | t }}</span>
                    {%- elsif product.compare_at_price > product.price -%}
                      <span class="mega-product__badge">{{ 'products.product.on_sale' | t }}</span>
                    {%- endif -%}
                  </span>
                  <span class="mega-product__title">{{ product.title | escape }}</span>
                  {% render 'price', product: product %}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- when 'collections' -%}
      {%- if promo.settings.collections != blank -%}
        <div class="mega-menu__featured mega-menu__featured--{{ promo.settings.featured_size | default: 'fill' }}">
          {%- if promo.settings.featured_heading != blank -%}
            <p class="mega-menu__title">{{ promo.settings.featured_heading }}</p>
          {%- endif -%}
          <ul class="mega-menu__featured-list" role="list">
            {%- for collection in promo.settings.collections limit: 5 -%}
              {%- assign collection_image = collection.featured_image | default: collection.products.first.featured_media.preview_image -%}
              <li>
                <a href="{{ collection.url }}" class="mega-collection">
                  <span class="mega-collection__media">
                    {%- if collection_image -%}
                      {{ collection_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: collection.title, sizes: '(min-width: 768px) 25vw, 60vw', widths: '240, 360, 500, 700' }}
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                    <span class="mega-collection__overlay">
                      <span class="mega-collection__title">{{ collection.title | escape }}</span>
                      <span class="mega-collection__count">{{ collection.products_count }} {% if collection.products_count == 1 %}peça{% else %}peças{% endif %}</span>
                    </span>
                  </span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- else -%}
      {%- for i in (1..2) -%}
        {%- liquid
          assign image_key = 'image_' | append: i
          assign label_key = 'label_' | append: i
          assign url_key = 'link_' | append: i
          assign promo_image = promo.settings[image_key]
          assign promo_label = promo.settings[label_key]
          assign promo_url = promo.settings[url_key]
        -%}
        {%- if promo_image != blank or promo_label != blank -%}
          <a href="{{ promo_url | default: '#' }}" class="mega-menu__card group">
            <div class="mega-menu__card-media">
              {%- if promo_image != blank -%}
                {{ promo_image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 200px, 50vw', widths: '300, 400, 600' }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <span class="mega-menu__card-label group-link-animation">{{ promo_label }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
  {%- endcase -%}
{%- endif -%}
