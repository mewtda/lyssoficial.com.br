{% doc %}
  Renders the physical store notice (label + highlight + address/hours), linked when a URL is set.

  @param {string} [class] - Extra classes

  @example
  {% render 'store-notice', class: 'footer__store' %}
{% enddoc %}

{%- if settings.store_label != blank -%}
  <div class="store-notice {{ class }}">
    {%- if settings.store_link != blank -%}
      <a href="{{ settings.store_link }}" class="store-notice__head" target="_blank" rel="noopener">
    {%- else -%}
      <p class="store-notice__head">
    {%- endif -%}
    {% render 'icon', icon: 'store' %}
    <span class="store-notice__label">{{ settings.store_label }}</span>
    {%- if settings.store_note != blank -%}
      <span class="store-notice__note">{{ settings.store_note }}</span>
    {%- endif -%}
    {%- if settings.store_link != blank -%}
      </a>
    {%- else -%}
      </p>
    {%- endif -%}

    {%- if settings.store_address != blank or settings.store_hours != blank -%}
      <address class="store-notice__details">
        {%- if settings.store_address != blank -%}
          <span>{{ settings.store_address | escape | newline_to_br }}</span>
        {%- endif -%}
        {%- if settings.store_hours != blank -%}
          <span>{{ settings.store_hours | escape | newline_to_br }}</span>
        {%- endif -%}
      </address>
    {%- endif -%}
  </div>
{%- endif -%}
