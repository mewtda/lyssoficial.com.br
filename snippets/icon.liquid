{% doc %}
  Renders an inline SVG icon.

  @param {string} icon - Icon name: menu, close, search, account, cart, chevron, arrow, plus, minus, filter, instagram, whatsapp, store, facebook, tiktok, pinterest, linkedin
  @param {string} [class] - Extra classes

  @example
  {% render 'icon', icon: 'cart' %}
{% enddoc %}

{%- case icon -%}
  {%- when 'menu' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
  {%- when 'close' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M5.5 5.5l13 13M18.5 5.5l-13 13"/></svg>
  {%- when 'search' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/></svg>
  {%- when 'account' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
