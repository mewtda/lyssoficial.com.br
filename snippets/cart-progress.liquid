{% doc %}
  Renders the free shipping progress bar based on the cart total.

  @example
  {% render 'cart-progress' %}
{% enddoc %}

{%- if settings.free_shipping_threshold > 0 -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign percent = cart.total_price | times: 100 | divided_by: threshold | at_most: 100
  -%}
  <div class="cart-progress">
    <p>
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}
        {{ settings.free_shipping_message | replace: '[amount]', remaining_money }}
      {%- else -%}
        {{ settings.free_shipping_success }}
      {%- endif -%}
    </p>
    <div class="cart-progress__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ percent }}">
      <div class="cart-progress__fill" style="width: {{ percent }}%;"></div>
    </div>
  </div>
{%- endif -%}
