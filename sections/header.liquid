{%- liquid
  assign menu = section.settings.menu
  assign logo_alt = section.settings.logo.alt | default: shop.name
  assign logo = section.settings.logo | default: settings.logo
  assign transparent = false
  if section.settings.transparent_home and request.page_type == 'index'
    assign transparent = true
  endif
  assign logo_transparent = section.settings.logo_transparent
-%}

<header
  class="header{% if transparent %} header--transparent{% if logo_transparent != blank %} header--has-transparent-logo{% endif %}{% endif %}"
  data-header
  {% if transparent %}data-header-transparent{% endif %}
  style="--logo-width: {{ settings.logo_width }}px; --logo-width-mobile: {{ settings.logo_width | times: 0.75 | round }}px; --header-transparent-text: {{ section.settings.transparent_text_color }};"
>
  <div class="header__logo-wrap">
    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if request.page_type == 'index' -%}
        <h1 class="visually-hidden">{{ shop.name }}</h1>
      {%- endif -%}
      {%- if logo != blank -%}
        {{ logo | image_url: width: 600 | image_tag: class: 'header__logo-img', alt: logo_alt, loading: 'eager', widths: '200, 300, 400, 600', sizes: '(min-width: 768px) 200px, 120px' }}
        {%- if transparent and logo_transparent != blank -%}
          {{ logo_transparent | image_url: width: 600 | image_tag: class: 'header__logo-img header__logo-img--transparent', alt: logo_alt, loading: 'eager', widths: '200, 300, 400, 600', sizes: '(min-width: 768px) 200px, 120px' }}
        {%- endif -%}
      {%- else -%}
        <span class="header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>
  </div>

  <div class="header__nav-wrap">
    <button
      type="button"
      class="icon-button header__menu-toggle"
      aria-controls="MobileMenu"
      aria-expanded="false"
      aria-label="{{ 'sections.header.menu' | t }}"
      data-menu-toggle
    >
      <span data-menu-icon-open>{% render 'icon', icon: 'menu' %}</span>
      <span data-menu-icon-close hidden>{% render 'icon', icon: 'close' %}</span>
    </button>

    {%- if menu != blank -%}
      <nav class="header__nav" aria-label="{{ 'sections.header.main_navigation' | t }}">
        <ul class="header__nav-list" role="list">
          {%- for link in menu.links -%}
            {%- liquid
              assign promo = nil
              for block in section.blocks
                assign wanted = block.settings.menu_item | strip | downcase
                assign current = link.title | strip | downcase
                if wanted == current
                  assign promo = block
                endif
              endfor
            -%}
            <li class="header__nav-item">
              {%- if link.links.size > 0 or promo -%}
                <a href="{{ link.url }}" class="header__nav-link" aria-haspopup="true">{{ link.title }}</a>
                <div class="mega-menu" data-mega-menu>
                  {% render 'mega-menu-content', link: link, promo: promo %}
                </div>
              {%- else -%}
                <a href="{{ link.url }}" class="header__nav-link"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>

  <div class="header__icons">
    {%- assign whatsapp_number = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' -%}
    {%- if whatsapp_number != blank -%}
      <a
        href="https://api.whatsapp.com/send/?phone={{ whatsapp_number }}&text&type=phone_number&app_absent=0"
        class="header__whatsapp desktop-only"
        target="_blank"
        rel="noopener"
      >
        {% render 'icon', icon: 'whatsapp' %}
        <span>{{ settings.whatsapp_header_label }}</span>
      </a>
    {%- endif -%}
    <button type="button" class="icon-button" aria-label="{{ 'sections.header.search' | t }}" aria-controls="SearchDialog" aria-expanded="false" data-search-toggle>
      {% render 'icon', icon: 'search' %}
    </button>
    <div class="header__localization">
      {% render 'localization-form' %}
    </div>
    {%- if shop.customer_accounts_enabled -%}
      <a href="{{ routes.account_url }}" class="icon-button desktop-only" aria-label="{{ 'sections.header.account' | t }}">
        {% render 'icon', icon: 'account' %}
      </a>
    {%- endif -%}
    <a href="{{ routes.cart_url }}" class="icon-button" aria-label="{{ 'sections.header.cart' | t }}" data-cart-toggle>
      {% render 'icon', icon: 'cart' %}
      <span class="cart-count" data-cart-count data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
    </a>
  </div>
</header>

<div class="mobile-menu" id="MobileMenu" data-mobile-menu>
  <div class="mobile-menu__scroll">
    {%- if menu != blank -%}
      {%- for link in menu.links -%}
        {%- liquid
          assign promo = nil
          for block in section.blocks
            assign wanted = block.settings.menu_item | strip | downcase
            assign current = link.title | strip | downcase
            if wanted == current
              assign promo = block
            endif
          endfor
        -%}
        {%- if link.links.size > 0 or promo -%}
          <details class="mobile-menu__item">
            <summary>
              <span>{{ link.title }}</span>
              {% render 'icon', icon: 'chevron' %}
            </summary>
            <div class="mobile-menu__panel">
              {% render 'mega-menu-content', link: link, promo: promo %}
            </div>
          </details>
        {%- else -%}
          <div class="mobile-menu__item">
            <a href="{{ link.url }}">{{ link.title }}</a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    <div class="mobile-menu__contact">
      {%- assign whatsapp_number = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' -%}
      {%- if whatsapp_number != blank -%}
        <a
          href="https://api.whatsapp.com/send/?phone={{ whatsapp_number }}&text&type=phone_number&app_absent=0"
          class="mobile-menu__whatsapp"
          target="_blank"
          rel="noopener"
        >
          {% render 'icon', icon: 'whatsapp' %}
          <span>{{ settings.whatsapp_header_label }}</span>
        </a>
      {%- endif -%}
      {% render 'store-notice', class: 'mobile-menu__store' %}
    </div>
  </div>
  <div class="mobile-menu__footer">
    {%- if shop.customer_accounts_enabled -%}
      <a href="{{ routes.account_url }}" class="mobile-menu__account">
        {% render 'icon', icon: 'account' %}
        <span>
          {%- if customer -%}
            {{ 'sections.header.my_account' | t }}
          {%- else -%}
            {{ 'sections.header.login' | t }}
          {%- endif -%}
        </span>
      </a>
    {%- endif -%}
    {% render 'localization-form' %}
  </div>
</div>

<div class="overlay" data-header-overlay></div>

{% schema %}
{
  "name": "Cabeçalho",
  "class": "header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Se vazio, usa o logo das configurações do tema ou o nome da loja."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Cabeçalho transparente"
    },
    {
      "type": "checkbox",
      "id": "transparent_home",
      "label": "Transparente na página inicial",
      "info": "Fica por cima do primeiro banner e volta ao fundo normal ao rolar a página.",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "logo_transparent",
      "label": "Logo (cabeçalho transparente)",
      "info": "Versão do logo para usar sobre o banner, ex.: branca."
    },
    {
      "type": "color",
      "id": "transparent_text_color",
      "label": "Cor dos textos e ícones (cabeçalho transparente)",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega menu (destaques)",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Item do menu",
          "info": "Título exato do item de primeiro nível (ex.: Joias)."
        },
        {
          "type": "select",
          "id": "content_type",
          "label": "O que destacar",
          "options": [
            { "value": "images", "label": "Imagens" },
            { "value": "products", "label": "Produtos" },
            { "value": "collections", "label": "Coleções" }
          ],
          "default": "images"
        },
        {
          "type": "text",
          "id": "featured_heading",
          "label": "Título dos destaques",
          "info": "Usado para produtos e coleções.",
          "default": "Destaques"
        },
        {
          "type": "select",
          "id": "featured_size",
          "label": "Tamanho dos destaques",
          "options": [
            { "value": "fill", "label": "Ocupar todo o espaço" },
            { "value": "large", "label": "Grande" },
            { "value": "medium", "label": "Médio" },
            { "value": "small", "label": "Pequeno" }
          ],
          "default": "fill"
        },
        {
          "type": "header",
          "content": "Produtos"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Produtos (até 5)",
          "limit": 5
        },
        {
          "type": "header",
          "content": "Coleções"
        },
        {
          "type": "collection_list",
          "id": "collections",
          "label": "Coleções (até 5)",
          "limit": 5
        },
        {
          "type": "header",
          "content": "Imagem 1"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Imagem"
        },
        {
          "type": "text",
          "id": "label_1",
          "label": "Legenda"
        },
        {
          "type": "url",
          "id": "link_1",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Imagem 2"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Imagem"
        },
        {
          "type": "text",
          "id": "label_2",
          "label": "Legenda"
        },
        {
          "type": "url",
          "id": "link_2",
          "label": "Link"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
