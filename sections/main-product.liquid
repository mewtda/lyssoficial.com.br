{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign media_count = product.media.size
  assign badge_tag = settings.card_badge_tag | strip | downcase
  assign show_badge = false
  for tag in product.tags
    assign t_down = tag | downcase
    if t_down == badge_tag
      assign show_badge = true
    endif
  endfor
-%}

<div class="product" data-product data-section="{{ section.id }}" data-url="{{ product.url }}">
  {%- capture top_info -%}
    <div class="product__top-info">
      {% render 'breadcrumbs' %}
      <h1 class="product__title">{{ product.title | escape }}</h1>
      <div class="product__price" data-product-price>
        {% render 'price', variant: current_variant %}
      </div>
    </div>
  {%- endcapture -%}

  {{ top_info | replace: '<h1 class="product__title">', '<p class="product__title">' | replace: '</h1>', '</p>' }}

  <div class="product__gallery slider" data-slider data-product-gallery>
    {%- if show_badge -%}
      <span class="product__badge">{{ settings.card_badge_label }}</span>
    {%- endif -%}
    <div class="slider__track" data-slider-track>
      {%- for media in product.media -%}
        <div class="slider__slide" data-slide data-media-id="{{ media.id }}">
          <div class="product__media" style="--ratio: {{ media.aspect_ratio | default: 0.757 }};">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- liquid
                  assign loading = 'lazy'
                  if forloop.first
                    assign loading = 'eager'
                  endif
                -%}
                {{ media | image_url: width: 2000 | image_tag: widths: '535, 750, 1000, 1500, 2000', sizes: '(min-width: 768px) 60vw, 100vw', loading: loading, alt: media.alt }}
              {%- when 'video' -%}
                {{ media | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1500x' }}
              {%- when 'external_video' -%}
                <div class="product__media-external">{{ media | external_video_tag }}</div>
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        </div>
      {%- else -%}
        <div class="slider__slide" data-slide>
          <div class="product__media">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if media_count > 1 -%}
      <button type="button" class="slider__arrow slider__arrow--prev" aria-label="{{ 'general.previous' | t }}" data-slider-prev>
        {% render 'icon', icon: 'arrow' %}
      </button>
      <button type="button" class="slider__arrow slider__arrow--next" aria-label="{{ 'general.next' | t }}" data-slider-next>
        {% render 'icon', icon: 'arrow' %}
      </button>
      <div class="slider__dots product__gallery-dots" data-slider-dots style="--dot-rgb: 255, 255, 255;">
        {%- for media in product.media -%}
          <button type="button" class="slider__dot" aria-label="{{ 'general.slide' | t: number: forloop.index }}" {% if forloop.first %}aria-current="true"{% endif %} data-slider-dot="{{ forloop.index0 }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product__info">
    {{ top_info }}

    {%- form 'product', product, class: 'product__form', data-product-form: '', novalidate: 'novalidate' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

      {%- unless product.has_only_default_variant -%}
        <div class="variant-picker">
          {%- for option in product.options_with_values -%}
            <fieldset class="variant-picker__option">
              <legend class="variant-picker__label">
                {{ option.name }}: <span data-option-selected="{{ forloop.index0 }}">{{ option.selected_value }}</span>
              </legend>
              <div class="variant-picker__values">
                {%- assign option_index = forloop.index0 -%}
                {%- for value in option.values -%}
                  {%- assign input_id = section.id | append: '-' | append: option_index | append: '-' | append: forloop.index0 -%}
                  <input
                    type="radio"
                    id="{{ input_id }}"
                    name="option-{{ option_index }}"
                    value="{{ value | escape }}"
                    data-option-input="{{ option_index }}"
                    {% if option.selected_value == value %}checked{% endif %}
                    {% unless value.available %}class="is-unavailable"{% endunless %}
                  >
                  {%- if value.swatch.color or value.swatch.image -%}
                    {%- liquid
                      if value.swatch.image
                        assign swatch_value = value.swatch.image | image_url: width: 64 | prepend: 'url(' | append: ')'
                      else
                        assign swatch_value = value.swatch.color
                      endif
                    -%}
                    <label for="{{ input_id }}" class="swatch-label" style="--swatch: {{ swatch_value }};" title="{{ value | escape }}">
                      <span class="visually-hidden">{{ value }}</span>
                    </label>
                  {%- else -%}
                    <label for="{{ input_id }}">{{ value }}</label>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      <div class="product__buy">
        <button
          type="submit"
          name="add"
          class="button button--full"
          data-add-to-cart
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {%- if current_variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </button>
        {%- if section.settings.show_dynamic_checkout -%}
          {{ form | payment_button }}
        {%- endif -%}
        <p class="product__error" data-product-error hidden></p>
      </div>
    {%- endform -%}

    <script type="application/json" data-product-json>
      {{ product.variants | json }}
    </script>

    <div class="product__details">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary>
                  {{ block.settings.heading }}
                  {% render 'icon', icon: 'plus' %}
                </summary>
                <div class="accordion__content rte">{{ product.description }}</div>
              </details>
            {%- endif -%}
          {%- when 'collapsible' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary>
                {{ block.settings.heading }}
                {% render 'icon', icon: 'plus' %}
              </summary>
              <div class="accordion__content rte">
                {{ block.settings.content }}
                {%- if block.settings.page != blank -%}
                  {{ block.settings.page.content }}
                {%- endif -%}
              </div>
            </details>
          {%- when 'text' -%}
            <div class="rte text-small" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- liquid
  assign video_ns = section.settings.video_metafield | split: '.' | first | strip
  assign video_key = section.settings.video_metafield | split: '.' | last | strip
  assign story_video = product.metafields[video_ns][video_key].value
-%}
{%- if story_video != blank -%}
  <div class="story-video" data-story-video>
    <button type="button" class="story-video__frame" aria-label="{{ product.title | escape }} – vídeo" data-story-video-toggle>
      {%- if story_video.media_type == 'video' -%}
        {{ story_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '540x' }}
      {%- else -%}
        <video src="{{ story_video }}" autoplay loop muted playsinline preload="metadata"></video>
      {%- endif -%}
    </button>
    <button type="button" class="story-video__close" aria-label="{{ 'general.close' | t }}" data-story-video-close>
      {% render 'icon', icon: 'close' %}
    </button>
  </div>
{%- endif -%}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Produto",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Mostrar botões de checkout rápido",
      "default": true
    },
    {
      "type": "text",
      "id": "video_metafield",
      "label": "Metafield do vídeo flutuante",
      "info": "namespace.chave do metafield de produto (arquivo de vídeo ou URL). Ex.: custom.video",
      "default": "custom.video"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "description",
      "name": "Descrição",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Descrição"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Aberto por padrão",
          "default": true
        }
      ]
    },
    {
      "type": "collapsible",
      "name": "Aba recolhível",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Entrega e devoluções"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Conteúdo"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Conteúdo de página"
        }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Parcele em até 3x sem juros.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
