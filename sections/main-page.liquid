<article class="main-page">
  {%- if section.settings.show_title -%}
    <h1 class="main-page__title">{{ page.title | escape }}</h1>
  {%- endif -%}
  <div class="rte">{{ page.content }}</div>
</article>

{% schema %}
{
  "name": "Página",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Mostrar título",
      "default": true
    }
  ]
}
{% endschema %}
