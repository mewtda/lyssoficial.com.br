<div class="customer">
  <h1 class="customer__title">{{ 'customer.reset.title' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="field">
      <label for="ResetPassword" class="visually-hidden">{{ 'customer.fields.password' | t }}</label>
      <input id="ResetPassword" class="field__input" type="password" name="customer[password]" autocomplete="new-password" placeholder="{{ 'customer.fields.password' | t }}" required>
    </div>
    <div class="field">
      <label for="ResetPasswordConfirm" class="visually-hidden">{{ 'customer.fields.password_confirm' | t }}</label>
      <input id="ResetPasswordConfirm" class="field__input" type="password" name="customer[password_confirmation]" autocomplete="new-password" placeholder="{{ 'customer.fields.password_confirm' | t }}" required>
    </div>
    <button type="submit" class="button button--full">{{ 'customer.reset.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Redefinir senha"
}
{% endschema %}
