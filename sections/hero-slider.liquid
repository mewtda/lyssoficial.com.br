{%- assign slide_count = section.blocks.size -%}

<div
  class="hero slider{% if section.settings.full_height_mobile %} hero--full-mobile{% endif %}"
  data-slider
  data-loop
  {% if section.settings.autoplay and slide_count > 1 %}data-autoplay="{{ section.settings.autoplay_speed | times: 1000 }}"{% endif %}
  style="--hero-height-mobile: {{ section.settings.height_mobile }}px;"
>
  <div class="slider__track" data-slider-track>
    {%- for block in section.blocks -%}
      {%- liquid
        assign loading = 'lazy'
        assign priority = 'low'
        if forloop.first
          assign loading = 'eager'
          assign priority = 'high'
        endif
        assign mobile_image = block.settings.image_mobile | default: block.settings.image
      -%}
      <div class="slider__slide" data-slide {{ block.shopify_attributes }}>
        <div
          class="hero__slide"
          style="--hero-text: {{ block.settings.text_color }}; --hero-overlay: {{ block.settings.overlay | divided_by: 100.0 }};"
        >
          {%- liquid
            assign video_desktop = block.settings.video | default: block.settings.video_mobile
            assign video_mobile = block.settings.video_mobile | default: block.settings.video
            assign image_desktop = block.settings.image | default: block.settings.image_mobile
            if block.settings.image != blank or block.settings.image_mobile != blank
              assign has_image = true
            else
              assign has_image = false
            endif
            # Vídeo tem prioridade; sem vídeo daquele tamanho de tela, usa a foto (só usa o outro vídeo se não houver foto)
            assign show_video_mobile = false
            if block.settings.video_mobile != blank or has_image == false and video_mobile != blank
              assign show_video_mobile = true
            endif
            assign show_video_desktop = false
            if block.settings.video != blank or has_image == false and video_desktop != blank
              assign show_video_desktop = true
            endif
          -%}

          {%- if show_video_mobile -%}
            {{ video_mobile | video_tag: muted: true, loop: true, playsinline: true, controls: false, preload: 'none', class: 'media-cover mobile-only hero__video', image_size: '1000x' }}
          {%- elsif has_image -%}
            {{ mobile_image | image_url: width: 1200 | image_tag: class: 'media-cover mobile-only', sizes: '100vw', widths: '375, 535, 750, 1000, 1200', loading: loading, fetchpriority: priority, alt: block.settings.heading }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg media-cover mobile-only' }}
          {%- endif -%}

          {%- if show_video_desktop -%}
            {{ video_desktop | video_tag: muted: true, loop: true, playsinline: true, controls: false, preload: 'none', class: 'media-cover desktop-only hero__video', image_size: '2000x' }}
          {%- elsif has_image -%}
            {{ image_desktop | image_url: width: 3000 | image_tag: class: 'media-cover desktop-only', sizes: '100vw', widths: '750, 1000, 1500, 2000, 2500, 3000', loading: loading, fetchpriority: priority, alt: block.settings.heading }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg media-cover desktop-only' }}
          {%- endif -%}

          <div class="hero__content {% if block.settings.alignment == 'center' %}hero__content--center{% endif %}">
            {%- if block.settings.subheading != blank -%}
              <p class="caption">{{ block.settings.subheading }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              {%- if forloop.first and request.page_type != 'index' -%}
                <h1 class="h1">{{ block.settings.heading }}</h1>
              {%- else -%}
<h2 class="h1" {% if forloop.index == 2 %}style="font-size: 42px;"{% endif %}>{{ block.settings.heading }}</h2>
              {%- endif -%}
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <span class="caption underline">{{ block.settings.link_label }}</span>
            {%- endif -%}
          </div>

          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="hero__link" aria-label="{{ block.settings.heading | default: block.settings.link_label | escape }}"></a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if slide_count > 1 -%}
    <div class="slider__dots hero__dots" data-slider-dots>
      {%- for block in section.blocks -%}
        <button type="button" class="slider__dot" aria-label="{{ 'general.slide' | t: number: forloop.index }}" {% if forloop.first %}aria-current="true"{% endif %} data-slider-dot="{{ forloop.index0 }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Slideshow principal",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_height_mobile",
      "label": "Tela cheia no celular",
      "default": true
    },
    {
      "type": "range",
      "id": "height_mobile",
      "info": "Usada quando a tela cheia no celular está desligada.",
      "label": "Altura no celular",
      "min": 350,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 500
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Trocar automaticamente",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Intervalo",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem (desktop)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagem (celular)"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Vídeo (desktop)",
          "info": "Tem prioridade sobre a imagem do desktop."
        },
        {
          "type": "video",
          "id": "video_mobile",
          "label": "Vídeo (celular)",
          "info": "Tem prioridade sobre a imagem do celular."
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Sobretítulo",
          "default": "NOVIDADE"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Nova coleção"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Texto do link",
          "default": "Descobrir"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alinhamento",
          "options": [
            { "value": "left", "label": "Esquerda" },
            { "value": "center", "label": "Centro" }
          ],
          "default": "left"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Cor do texto",
          "default": "#ffffff"
        },
        {
          "type": "range",
          "id": "overlay",
          "label": "Escurecer imagem",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow principal",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
