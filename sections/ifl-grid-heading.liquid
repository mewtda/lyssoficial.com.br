{% render 'ifl-assets' %}
<div class="ifl ifl-gridhead">
  <div class="ifl-gridhead__in page-width ifl-reveal">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.show_count and collection -%}
      <p class="ifl-eyebrow">{{ collection.products_count }} {{ section.settings.count_label }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "IF · Título da grade",
  "tag": "div",
  "class": "ifl-section",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Toda a coleção" },
    { "type": "checkbox", "id": "show_count", "label": "Mostrar quantidade", "default": true },
    { "type": "text", "id": "count_label", "label": "Texto da quantidade", "default": "joias" }
  ],
  "presets": [{ "name": "IF · Título da grade" }]
}
{% endschema %}
