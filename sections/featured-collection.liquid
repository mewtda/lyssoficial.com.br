{%- liquid
  assign limit = section.settings.products_to_show
  assign has_tabs = false
  if section.settings.heading_2 != blank
    assign has_tabs = true
  endif
  assign tab_count = 1
  if has_tabs
    assign tab_count = 2
  endif
-%}

<div
  class="featured-products section-padding"
  style="--pt-mobile: {{ section.settings.padding_top_mobile }}px; --pb-mobile: {{ section.settings.padding_bottom_mobile }}px; --pt-desktop: {{ section.settings.padding_top }}px; --pb-desktop: {{ section.settings.padding_bottom }}px;"
  {% if has_tabs %}data-tabs{% endif %}
>
  {%- if has_tabs -%}
    <div class="featured-products__tabs featured-products__heading page-width" role="tablist">
      {%- for i in (1..2) -%}
        {%- liquid
          if i == 1
            assign label = section.settings.heading
          else
            assign label = section.settings.heading_2
          endif
        -%}
        <button
          type="button"
          class="{{ section.settings.heading_style }} featured-products__tab"
          role="tab"
          id="Tab-{{ section.id }}-{{ i }}"
          aria-controls="TabPanel-{{ section.id }}-{{ i }}"
          aria-selected="{% if i == 1 %}true{% else %}false{% endif %}"
          data-tab
        >
          {{- label -}}
        </button>
      {%- endfor -%}
    </div>
  {%- elsif section.settings.heading != blank -%}
    <h2 class="{{ section.settings.heading_style }} featured-products__heading page-width">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- for i in (1..tab_count) -%}
    {%- liquid
      if i == 1
        assign collection = section.settings.collection
      else
        assign collection = section.settings.collection_2
      endif
    -%}
    <div
      class="featured-products__panel"
      {% if has_tabs %}
        role="tabpanel" id="TabPanel-{{ section.id }}-{{ i }}" aria-labelledby="Tab-{{ section.id }}-{{ i }}" data-tab-panel
        {% unless i == 1 %}hidden{% endunless %}
      {% endif %}
    >
      <div class="page-width">
        {%- if section.settings.layout == 'slider' -%}
          <div
            class="slider"
            data-slider
            data-loop
            style="--per-view-mobile: 2; --per-view-tablet: 3; --per-view-desktop: {{ section.settings.columns_desktop }}; --slider-gap-mobile: 4px; --slider-gap-desktop: 4px;"
          >
            <div class="slider__track" data-slider-track>
              {%- if collection != blank and collection.products_count > 0 -%}
                {%- for product in collection.products limit: limit -%}
                  <div class="slider__slide" data-slide>
                    {% render 'product-card', product: product %}
                  </div>
                {%- endfor -%}
              {%- else -%}
                {%- for n in (1..4) -%}
                  <div class="slider__slide" data-slide>
                    {% render 'product-card' %}
                  </div>
                {%- endfor -%}
              {%- endif -%}
            </div>
            <button type="button" class="slider__arrow slider__arrow--prev" aria-label="{{ 'general.previous' | t }}" data-slider-prev>
              {% render 'icon', icon: 'arrow' %}
            </button>
            <button type="button" class="slider__arrow slider__arrow--next" aria-label="{{ 'general.next' | t }}" data-slider-next>
              {% render 'icon', icon: 'arrow' %}
            </button>
            <div class="slider__stripes" data-slider-stripes hidden></div>
          </div>
        {%- else -%}
          <div class="featured-products__grid" style="--columns-desktop: {{ section.settings.columns_desktop }};">
            {%- if collection != blank and collection.products_count > 0 -%}
              {%- for product in collection.products limit: limit -%}
                {% render 'product-card', product: product %}
              {%- endfor -%}
            {%- else -%}
              {%- for n in (1..4) -%}
                {% render 'product-card' %}
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_view_all and collection != blank -%}
        <div class="featured-products__footer page-width">
          <a href="{{ collection.url }}" class="button button--secondary">{{ 'sections.featured_collection.view_all' | t }}</a>
        </div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Produtos em destaque",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título (aba 1)",
      "default": "em alta"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Estilo do título",
      "options": [
        { "value": "h3", "label": "Caixa alta (sans)" },
        { "value": "heading-serif", "label": "Serifado" }
      ],
      "default": "h3"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção (aba 1)"
    },
    {
      "type": "header",
      "content": "Aba 2",
      "info": "Preencha o título para mostrar as duas abas."
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Título (aba 2)"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Coleção (aba 2)"
    },
    {
      "type": "header",
      "content": "Exibição"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Número de produtos",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "slider", "label": "Carrossel" },
        { "value": "grid", "label": "Grade" }
      ],
      "default": "slider"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Produtos por linha (desktop)",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Mostrar botão \"Ver tudo\"",
      "default": false
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Topo (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Base (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Topo (celular)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Base (celular)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Produtos em destaque"
    }
  ]
}
{% endschema %}
