<div class="password-page">
  <span class="header__logo-text">{{ shop.name }}</span>
  {%- if section.settings.heading != blank -%}
    <h1 class="h2">{{ section.settings.heading }}</h1>
  {%- endif -%}
  {%- if shop.password_message != blank -%}
    <p>{{ shop.password_message }}</p>
  {%- endif -%}

  {%- form 'customer', class: 'password-page__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="field">
      <label for="PasswordNewsletter" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
      <input id="PasswordNewsletter" type="email" name="contact[email]" class="field__input" placeholder="{{ 'newsletter.email' | t }}" required>
      <button type="submit" class="field__button" aria-label="{{ 'newsletter.subscribe' | t }}">{% render 'icon', icon: 'arrow' %}</button>
    </div>
    {%- if form.posted_successfully? -%}
      <p class="form-success">{{ 'newsletter.success' | t }}</p>
    {%- endif -%}
  {%- endform -%}

  <details>
    <summary class="caption underline">{{ 'password.enter' | t }}</summary>
    {%- form 'storefront_password', class: 'password-page__form' -%}
      <div class="field" style="margin-top: 16px;">
        <label for="StorefrontPassword" class="visually-hidden">{{ 'password.password' | t }}</label>
        <input id="StorefrontPassword" type="password" name="password" class="field__input" placeholder="{{ 'password.password' | t }}" autocomplete="current-password">
        <button type="submit" class="field__button" aria-label="{{ 'password.enter' | t }}">{% render 'icon', icon: 'arrow' %}</button>
      </div>
      {{ form.errors | default_errors }}
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Senha",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Em breve"
    }
  ]
}
{% endschema %}
