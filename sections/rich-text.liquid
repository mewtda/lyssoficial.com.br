<div
  class="section-padding"
  style="--pt-mobile: {{ section.settings.padding_top | times: 0.6 | round }}px; --pb-mobile: {{ section.settings.padding_bottom | times: 0.6 | round }}px; --pt-desktop: {{ section.settings.padding_top }}px; --pb-desktop: {{ section.settings.padding_bottom }}px;"
>
  <div class="rich-text {% if section.settings.alignment == 'left' %}rich-text--left{% endif %}">
    {%- if section.settings.subheading != blank -%}
      <p class="caption">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="button">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Texto",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Sobretítulo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Conte sua história"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Compartilhe informações sobre sua marca com seus clientes.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alinhamento",
      "options": [
        { "value": "center", "label": "Centro" },
        { "value": "left", "label": "Esquerda" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaço no topo",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaço na base",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Texto"
    }
  ]
}
{% endschema %}
