<div class="search-page">
  <div class="search-page__header">
    <h1 class="search-page__title">{{ blog.title | escape }}</h1>
  </div>
  {%- paginate blog.articles by 12 -%}
    <div class="blog-grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="article-card">
          <div class="article-card__media">
            {%- if article.image -%}
              {{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 33vw, 100vw', widths: '375, 535, 750, 1000', alt: article.title }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="article-card__info">
            <span class="article-card__date">{{ article.published_at | time_tag: format: 'date' }}</span>
            <h2 class="article-card__title">{{ article.title | escape }}</h2>
            <span class="caption underline">{{ 'blogs.read_more' | t }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog"
}
{% endschema %}
